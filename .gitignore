# =============================================================
# Tech-Start-Hackathon-2026 — Git ignore rules
# Stack: Next.js (frontend) + Node.js/Express + SQLite (backend)
#
# Rules for generated folders are ANCHORED (start with "/") so they
# only match where tools actually create them. A feature folder
# such as backend/src/routes/logs/ or frontend/components/build/
# will still be committed.
#
# To check why a file is ignored:  git check-ignore -v <path>
# =============================================================

# ---------- Dependencies (safe to match anywhere) ----------
node_modules/

# ---------- Environment & secrets (safe to match anywhere) ----------
.env
.env.*
!.env.example
*.pem

# ---------- Frontend: Next.js build output ----------
.next/
/frontend/out/
/frontend/build/
/frontend/next-env.d.ts
*.tsbuildinfo
.vercel/

# ---------- Backend: build output ----------
/backend/dist/
/backend/build/

# ---------- Test coverage (generated by `npm test`) ----------
/backend/coverage/
/frontend/coverage/

# ---------- Local SQLite databases ----------
# Rebuild with: cd backend && npm run migrate:up
/backend/*.sqlite
/backend/*.sqlite3
/backend/*.sqlite-journal
/backend/*.sqlite-wal
/backend/*.sqlite-shm

# ---------- Logs ----------
*.log
npm-debug.log*
/backend/logs/

# ---------- Caches ----------
.cache/
.eslintcache

# ---------- Editors & IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini
